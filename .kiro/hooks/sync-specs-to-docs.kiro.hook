{
  "enabled": true,
  "name": "Sync Specs to Docs",
  "description": "When a markdown file in .kiro/specs/ is saved, run the sync script to mirror it to docs/specs/ as a read-only copy.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      ".kiro/specs/**/*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A spec file in .kiro/specs/ was just saved. Run `bash scripts/sync-specs.sh` to sync the changes to docs/specs/. Only run the sync script — do not edit any spec files."
  }
}