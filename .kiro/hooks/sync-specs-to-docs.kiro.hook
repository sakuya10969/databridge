{
  "enabled": true,
  "name": "Sync Specs to Docs on Edit",
  "description": "When a markdown file in .kiro/specs/ is edited, run the sync script to mirror it to docs/specs/ as a read-only copy.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      ".kiro/specs/**/*.md",
      ".kiro/specs/INDEX.md"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "bash scripts/sync-specs.sh"
  }
}
