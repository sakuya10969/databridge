{
  "enabled": true,
  "name": "Sync Specs to Docs on Create",
  "description": "When a new markdown file is created in .kiro/specs/, run the sync script to mirror it to docs/specs/ as a read-only copy.",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      ".kiro/specs/**/*.md"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "bash scripts/sync-specs.sh"
  }
}
